# ============================================================
#  Keycloak + MySQL - environment settings (LOCAL DEV)
#  Change the passwords before sharing this project.
# ============================================================

# --- Versions ---
KEYCLOAK_VERSION=26.4.7
MYSQL_VERSION=8.4

# --- Host ports ---
KEYCLOAK_PORT=8080
MYSQL_PORT=3307

# --- MySQL ---
MYSQL_ROOT_PASSWORD=RootPass_ChangeMe1!
MYSQL_DATABASE=keycloak
MYSQL_USER=keycloak
MYSQL_PASSWORD=KcDbPass_ChangeMe1!

# --- Temporary bootstrap admin (used only on first start) ---
KC_BOOTSTRAP_ADMIN_USERNAME=tmp-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=TmpAdmin_ChangeMe1!

# --- Initial user (master admin + ugec realm admin) ---
INITIAL_USER_EMAIL=mamondala@apobatangas.com
INITIAL_USER_FIRSTNAME=Marvin
INITIAL_USER_LASTNAME=Mondala
# Temporary password - you will be asked to change it on first login
INITIAL_USER_PASSWORD=Welcome_ChangeMe1!
